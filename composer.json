{
  "name": "alangiacomin/laravel-template",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": ["laravel", "framework"],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "inertiajs/inertia-laravel": "^3.7.0",
    "laravel/framework": "^13.43.0",
    "laravel/nightwatch": "^1.30.6",
    "laravel/reverb": "^1.14.0",
    "laravel/tinker": "^3.2.0",
    "resend/resend-laravel": "^1.7.0",
    "spatie/enum": "^3.13.0",
    "spatie/laravel-data": "^4.23.1",
    "spatie/laravel-permission": "^8.5.0",
    "spatie/laravel-typescript-transformer": "^3.3.0",
    "symfony/mailer": "^8.1.10",
    "tightenco/ziggy": "^2.7.0"
  },
  "require-dev": {
    "fakerphp/faker": "^v1.24.1",
    "larastan/larastan": "^3.15.0",
    "laravel/boost": "^2.10.4",
    "laravel/pail": "^1.3.0",
    "laravel/pint": "^1.32.3",
    "laravel/sail": "^1.71.0",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.6",
    "phpunit/phpunit": "^13.4.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan boost:update --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi",
      "@php artisan db:seed",
      "@php artisan boost:install",
      "bun install",
      "bun run build",
      "git init .",
      "git add .",
      "git commit -m \"First commit\""
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "bunx concurrently --raw \"php artisan serve --host 0.0.0.0\" \"php artisan reverb:start --port=9000\" \"php artisan queue:listen\" \"bun run dev\""
    ],
    "lint": [
      "vendor/bin/pint",
      "vendor/bin/phpstan analyse --memory-limit=1G --error-format=table"
    ],
    "test": ["@php artisan config:clear --ansi", "@php artisan test"],
    "test-coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "@php artisan config:clear --ansi",
      "@php artisan test --coverage"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
