{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "ziggy:generate": "php artisan ziggy:generate",
    "prebuild": "php artisan ziggy:generate",
    "build": "vite build",
    "predev": "php artisan ziggy:generate",
    "dev": "vite",
    "dev:debug": "vite --debug hmr",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.21.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "laravel-vite-plugin": "^3.2.1",
    "lightningcss": "^1.33.0",
    "rolldown": "^1.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@inertiajs/react": "^3.11.0",
    "@laravel/echo-react": "^2.6.3",
    "@vitejs/plugin-react": "^6.2.1",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "fs-extra": "^11.4.1",
    "js-cookie": "^3.0.8",
    "laravel-echo": "^2.6.3",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-toastify": "^11.2.0",
    "toastr": "^2.1.4",
    "vite-plugin-babel": "^1.7.3"
  }
}
